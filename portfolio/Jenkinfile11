pipeline {
    agent any 

    tools {
        nodejs "Node20" // make sure this matches the tool name in Jenkins config
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '2'))
        timestamps()
    }

    parameters {
        string(name: 'BRANCH_NAME', defaultValue: 'main', description: 'Git branch to build')
        string(name: 'DOCKER_PORT', defaultValue: '3090', description: 'Port to expose the app (non-prod)')
    }

    environment {
        REGISTRY = "shettyadarsha"
        IMAGE_NAME = "portfolio-app"
        APP_PORT = "80"
        LB_PORT = "${params.DOCKER_PORT}"  // Optional: using the passed param
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "${params.BRANCH_NAME}", 
                    changelog: false, 
                    poll: false, 
                    url: 'https://github.com/adarshadshetty09/Docker.git'
            }
        }

        stage("List all the file in this Git Repo") {
            steps {
                sh "ls -lart"
            }
        }

        stage("List all the files inside the Portfolio Project") {
            steps {
                dir('portfolio') {
                    sh "ls -lart"
                }
            }
        }

        stage('Get Commit Hash') {
            steps {
                script {
                    env.COMMIT_HASH = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                }
                echo "Commit Hash: ${env.COMMIT_HASH}"
            }
        }

        // stage('Run Tests') {
        //     steps {
        //         dir('portfolio') {
        //             sh 'npm install'
        //             sh 'npm test'
        //         }
        //     }
        //     post {
        //         always {
        //             script {
        //                 if (fileExists('portfolio/test-results')) {
        //                     junit 'portfolio/test-results/*.xml'
        //                 } else {
        //                     echo "⚠️ No test results found to archive."
        //                 }
        //             }
        //         }
        //     }
        // }

        stage('Lint & Security Scan') {
            parallel {
                stage('Lint Dockerfile') {
                    steps {
                        dir("portfolio") {
                            script {
                                echo "Running Hadolint..."
                                sh 'hadolint Dockerfile || true'
                            }
                        }
                    }
                }

                stage('Build Docker Image') {
                    steps {
                        dir("portfolio") {
                            script {
                                echo "Building Docker image . . ."
                                sh """
                                    docker build -t $REGISTRY/$IMAGE_NAME:${BUILD_NUMBER} .
                                    docker tag $REGISTRY/$IMAGE_NAME:${BUILD_NUMBER} $REGISTRY/$IMAGE_NAME:${COMMIT_HASH}
                                    docker tag $REGISTRY/$IMAGE_NAME:${BUILD_NUMBER} $REGISTRY/$IMAGE_NAME:latest
                                """
                            }
                        }
                    }
                }

                stage('Security Scan') {
                    steps {
                        script {
                            echo "Scanning Docker image for vulnerabilities..."
                            sh """
                                trivy image --exit-code 0 --severity HIGH,CRITICAL $REGISTRY/$IMAGE_NAME:${BUILD_NUMBER} || true
                            """
                        }
                    }
                }
            }
        }
        // Stage: Push Docker image to private Artifactory registry 
stage('Push to Artifactory'){
    steps {
        withDockerRegistry(credentialsId: 'docker-cred', url: 'https://index.docker.io/v1/') {
            sh """
                docker push $REGISTRY/$IMAGE_NAME:${BUILD_NUMBER}
                docker push $REGISTRY/$IMAGE_NAME:${COMMIT_HASH}
                docker push $REGISTRY/$IMAGE_NAME:latest
            """
        }
    }
}


        // Stage: Cleanup unused Docker images
        stage('Clean Old Images'){
            steps{
                script{
                    echo "Cleaning up unused Docker images..."
                    sh "docker image prune -af || true"
                }
            }
        }

        // Stage: Clean Jenkins Workspace
        stage('Workspace Cleanup'){
            steps{
                cleanWs()
            }
        }
    }
}
