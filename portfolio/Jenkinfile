pipeline {
    agent any
    
    environment {
        IMAGE_NAME = 'shettyadarsha/myportfolio-app'
        CONTAINER_NAME = 'my-portfolio'
        PORT = '3090'
        DOCKERHUB_CREDENTIALS_ID = 'dockerhub-cred' // Jenkins credentials ID
    }   
    stages {
        stage('Project Detail') {
            steps {
                echo '📦 Dockerize the portfolio, push to Docker Hub, and redeploy it.'
            }
        }
        stage("Git Check-Out"){
            steps {
                git branch: 'main', changelog: false, credentialsId: 'git-cred', poll: false, url: 'https://github.com/adarshadshetty09/Docker.git'
            }
        }
        stage("Build the Docker Image"){
            steps {
                dir('portpolio'){
                    sh 'docker build -t portfolio-app .'
                }
            }
        }
        
        stage('Push the docker image to a docker-hub'){
            steps {
                sh "docker tag portfolio-app ${IMAGE_NAME}:latest"
                withDockerRegistry(url: 'https://index.docker.io/v1/', credentialsId: 'docker-cred') {
                    sh "docker push ${IMAGE_NAME}:latest"
                    
                }
                
            }
            
        }

        stage("Deploy the Docker Image"){
            steps {
                sh """
                  docker rm -f ${CONTAINER_NAME} || true
                  docker run -d -p ${PORT}:80 --name ${CONTAINER_NAME} ${IMAGE_NAME}:latest
                """
            }
        }
    }
}

